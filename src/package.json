    "security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@formepdf/core": "^0.23.0",
    "@formepdf/react": "^0.23.0",
    "chart.js": "^4.4.9",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-wasm": "^3.6.0"
  }
}
